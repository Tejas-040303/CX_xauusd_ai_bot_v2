# ─────────────────────────────────────────────────────────
# Project MIDAS v2 — environment template
#
# Copy to ".env" in the PROJECT ROOT (next to src/), then fill in.
#   Windows:  copy .env.example .env
#
# .env is gitignored. Never commit real tokens.
# If a token was ever pushed or pasted anywhere public, revoke and
# reissue it rather than reusing it.
# ─────────────────────────────────────────────────────────

# ─── Telegram (REQUIRED for alerts + remote control) ─────
# TELEGRAM_TOKEN   : from @BotFather -> /mybots -> API Token
# TELEGRAM_CHAT_ID : your numeric chat id, from @userinfobot
#
# If either is blank the bot still trades, but TelegramNotifier
# sets enabled=False, prints "Telegram: disabled", and you lose all
# alerts AND the /stop and /pause kill switches.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Claude API (NOT USED — safe to leave blank) ─────────
# config.py reads CLAUDE_API_KEY and defines CLAUDE_MODEL, but nothing
# imports them: src/claude_brain.py is a 0-byte placeholder and no module
# calls the Anthropic API. Leaving this empty changes no behaviour.
# Only fill it in if you actually implement claude_brain.py.
CLAUDE_API_KEY=

# ─── MT5 / trading account ───────────────────────────────
# Deliberately NOT configured here.
# mt5_executor.py calls mt5.initialize() with no arguments, which attaches
# to whichever MetaTrader 5 terminal is already running and logged in on
# this machine. You switch accounts by logging in inside the MT5 terminal,
# not by editing this file. See SETUP.md, Step 3.
